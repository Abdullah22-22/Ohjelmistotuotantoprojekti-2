<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="fi.metropolia.tempconverter.controller.MainController"
      spacing="12">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="%app.heading" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <padding>
            <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>

        <Label text="%label.value"
               GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="inputField" promptText="%field.prompt"
                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="%label.fromUnit"
               GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <ComboBox fx:id="fromUnitBox" prefWidth="220.0"
                  GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="%label.toUnit"
               GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <ComboBox fx:id="toUnitBox" prefWidth="220.0"
                  GridPane.columnIndex="1" GridPane.rowIndex="2"/>
    </GridPane>

    <Label fx:id="descriptionLabel" text="" wrapText="true"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="%button.convert" onAction="#onConvert"/>
        <Button text="%button.refresh" onAction="#onRefresh"/>
        <Button text="%button.delete" onAction="#onDelete"/>
    </HBox>

    <Label fx:id="resultLabel" text="%label.result" style="-fx-font-size: 16px;"/>

    <Label text="%label.lastFive"/>

    <TableView fx:id="table" prefHeight="200.0">
        <columns>
            <TableColumn fx:id="idCol"        text="%col.id"        prefWidth="40.0"/>
            <TableColumn fx:id="inputCol"     text="%col.input"     prefWidth="80.0"/>
            <TableColumn fx:id="fromCol"      text="%col.fromUnit"  prefWidth="110.0"/>
            <TableColumn fx:id="convertedCol" text="%col.converted" prefWidth="80.0"/>
            <TableColumn fx:id="toCol"        text="%col.toUnit"    prefWidth="110.0"/>
            <TableColumn fx:id="langCol"      text="%col.lang"      prefWidth="50.0"/>
            <TableColumn fx:id="createdCol"   text="%col.created"   prefWidth="150.0"/>
        </columns>
    </TableView>

    <Label fx:id="statusLabel" text="%status.ready"/>
</VBox>